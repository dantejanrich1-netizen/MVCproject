<div class="d-flex justify-content-center align-items-center" style="min-height: 80vh;">
    <div class="card shadow-sm w-100" style="max-width: 400px;">
        <div class="card-header bg-dark text-white text-center border-0">
            <h4 class="mb-0 py-2">Admin Login</h4>
        </div>
        <div class="card-body p-4">
            @if (TempData["Msg"] != null)
            {
                <div class="alert alert-success text-center">@TempData["Msg"]</div>
            }
            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger text-center">@ViewBag.Error</div>
            }
            <form asp-action="Login" method="post">
                <input name="username" class="form-control mb-3 p-2" placeholder="Username" required />
                <input name="password" type="password" class="form-control mb-4 p-2" placeholder="Password" required />
                <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">Login</button>
            </form>
            <div class="text-center mt-3">
                <a asp-action="Register" class="text-white text-decoration-none small">Create an account</a>
            </div>
        </div>
    </div>
</div>