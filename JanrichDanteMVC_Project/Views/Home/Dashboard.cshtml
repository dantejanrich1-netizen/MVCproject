@model IEnumerable<JanrichDanteMVC_Project.Models.Student>
<div class="alert alert-info border-0 shadow-sm">
    <h4 class="mb-0">Welcome, @ViewBag.Admin! | Total Students: @ViewBag.Total</h4>
</div>

<div class="d-flex justify-content-between mb-3 mt-4">
    <form asp-action="Dashboard" method="get" class="d-flex w-50">
        <input type="text" name="search" value="@ViewBag.Search" class="form-control me-2" placeholder="Search name or ID..." />
        <button type="submit" class="btn btn-secondary">Search</button>
    </form>
    <a asp-action="StudentForm" class="btn btn-success">Add Student</a>
</div>

<div class="card shadow-sm">
    <table class="table table-striped mb-0">
        <thead class="table-dark">
            <tr><th>ID</th><th>Name</th><th>Course/Yr</th><th>Email</th><th>Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var s in Model) {
                <tr>
                    <td>@s.StudentNumber</td><td>@s.FirstName @s.LastName</td>
                    <td>@s.Course - @s.YearLevel</td><td>@s.Email</td>
                    <td>
                        <form asp-action="Delete" asp-route-id="@s.Id" method="post" style="display:inline;" onsubmit="return confirm('Delete @s.FirstName?');">
                            <a asp-action="StudentForm" asp-route-id="@s.Id" class="btn btn-sm btn-primary">Edit</a>
                            <button type="submit" class="btn btn-sm btn-danger">Del</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>