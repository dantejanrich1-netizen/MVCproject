@model JanrichDanteMVC_Project.Models.Instructor

<div class="card shadow-sm border-0 bg-transparent p-4">
    <h2>Delete Instructor</h2>
    <h4 class="text-danger">Are you sure you want to delete this record?</h4>

    <dl class="row mt-3">
        <dt class="col-sm-3">First Name</dt>
        <dd class="col-sm-9">@Model.FirstName</dd>

        <dt class="col-sm-3">Last Name</dt>
        <dd class="col-sm-9">@Model.LastName</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger mt-2">Confirm Delete</button>
        <a asp-action="Index" class="btn btn-secondary mt-2">Cancel</a>
    </form>
</div>