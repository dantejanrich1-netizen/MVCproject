@model JanrichDanteMVC_Project.Models.Instructor

<div class="card shadow-sm border-0 bg-transparent p-4">
    <h2>Instructor Details</h2>
    <dl class="row mt-3">
        <dt class="col-sm-3">ID</dt>
        <dd class="col-sm-9">@Model.Id</dd>

        <dt class="col-sm-3">First Name</dt>
        <dd class="col-sm-9">@Model.FirstName</dd>

        <dt class="col-sm-3">Last Name</dt>
        <dd class="col-sm-9">@Model.LastName</dd>

        <dt class="col-sm-3">Email</dt>
        <dd class="col-sm-9">@Model.Email</dd>

        <dt class="col-sm-3">Department</dt>
        <dd class="col-sm-9">@Model.Department</dd>
    </dl>
    <div>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-success mt-2">Edit</a>
        <a asp-action="Index" class="btn btn-secondary mt-2">Back to List</a>
    </div>
</div>